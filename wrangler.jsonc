{
  // The Recipe Thing: one Cloudflare Worker serves the app and its API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-thing",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // All recipes and accounts live in one small SQLite database inside a Durable Object.
  // No IDs to copy around: it is created automatically on first deploy.
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "vars": {
    // Which Claude model does the AI work. Haiku is the cheapest.
    "AI_MODEL": "claude-haiku-5-5",
    // Safety limits on AI use, per person per day and for everyone per day.
    "AI_DAILY_PER_USER": "80",
    "AI_DAILY_TOTAL": "400"
  }
  // Secrets (set in the Cloudflare dashboard, never in this file):
  //   ANTHROPIC_API_KEY  - required
  //   SIGNUP_CODE        - optional; if set, new accounts need this code
}
