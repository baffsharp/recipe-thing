{
  // The Recipe Thing: one Cloudflare Worker serves the app and its API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-thing",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // All recipes and accounts live in one small SQLite database inside a Durable Object.
  // No IDs to copy around: it is created automatically on first deploy.
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "vars": {
    // Which Claude model does the AI work. Haiku is the cheapest.
    "AI_MODEL": "claude-haiku-5-5",
    // Safety limits on AI use, per person per day and for everyone per day.
    "AI_DAILY_PER_USER": "40",
    "AI_DAILY_TOTAL": "150",
    // How much Claude credit you've bought in total, in US dollars. Change it when you top up.
    // The Kitchen page shows how much is used and warns when it's running low.
    "AI_BUDGET_USD": "5",
    // Claude Haiku prices per million words-pieces (tokens), used to work out the spend.
    "PRICE_IN_PER_MILLION": "0.10",
    "PRICE_OUT_PER_MILLION": "0.50"
  }
  // Secrets (set in the Cloudflare dashboard, never in this file):
  //   ANTHROPIC_API_KEY  - required
}
